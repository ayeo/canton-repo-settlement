// Brings the running containers' topology to a working state. Idempotent.
//
// Node references come from canton/conf/remote.conf; party values are suffixed *Party.

val synchronizerName = "mysynchronizer"

// A Docker network hostname: each participant connects from its own container.
val sequencerUrl = "http://sequencer:5001"

val modelDar = "canton/model/.daml/dist/repo-model-0.1.0.dar"

val participants = Seq(icsd, centralbank, alpha, bravo, charlie)

// --- 1. Synchronizer ---------------------------------------------------
// Binds the separate sequencer and mediator nodes into one synchronizer.
if (!sequencer1.health.initialized()) {
  val id = bootstrap.synchronizer(
    synchronizerName = synchronizerName,
    sequencers = Seq(sequencer1),
    mediators = Seq(mediator1),
    synchronizerOwners = Seq(sequencer1),
    synchronizerThreshold = PositiveInt.one,
    staticSynchronizerParameters =
      StaticSynchronizerParameters.defaultsWithoutKMS(ProtocolVersion.v35)
  )
  println(s"[bootstrap] synchronizer created: $id")
} else {
  println("[bootstrap] synchronizer already initialised - skipping")
}

// --- 2. Connect the participants ---------------------------------------
participants.foreach { p =>
  if (p.synchronizers.list_registered().isEmpty) {
    p.synchronizers.connect(synchronizerName, sequencerUrl)
    println(s"[bootstrap] ${p.name} connected to the synchronizer")
  } else {
    println(s"[bootstrap] ${p.name} already connected - skipping")
  }
}

// --- 3. Model ----------------------------------------------------------
// A DAR does not propagate through the synchronizer; re-uploading is safe.
participants.foreach(_.dars.upload(modelDar))
println("[bootstrap] model uploaded to all five participants")

// --- 4. Parties --------------------------------------------------------
// One party per node, holding only its own keys: no node can act for another
// party, enforced by the topology rather than the model.
def ensureParty(p: com.digitalasset.canton.console.ParticipantReference, name: String) = {
  val existing = p.parties.list(filterParty = name)
  if (existing.isEmpty) p.parties.enable(name) else existing.head.party
}

val icsdParty        = ensureParty(icsd, "ICSD")
val centralBankParty = ensureParty(centralbank, "CentralBank")
val alphaParty       = ensureParty(alpha, "AlphaBank")
val bravoParty       = ensureParty(bravo, "BravoBank")
val charlieParty     = ensureParty(charlie, "CharlieBank")

val partyNames = Seq("ICSD", "CentralBank", "AlphaBank", "BravoBank", "CharlieBank")

// --- 5. Topology propagation -------------------------------------------
// Every node must know every party before transacting with it.
utils.retry_until_true {
  participants.forall { p =>
    partyNames.forall(n => p.parties.list(filterParty = n).nonEmpty)
  }
}

// --- 6. Export configuration for the application ------------------------
// Party identifiers (name plus key fingerprint) and ledger endpoints are only
// known here, so they are written out for the application.
def ledgerEndpoint(config: com.digitalasset.canton.participant.config.RemoteParticipantConfig) =
  s"${config.clientLedgerApi.address}:${config.clientLedgerApi.port.unwrap}"

java.nio.file.Files.writeString(
  java.nio.file.Path.of("ledger.properties"),
  s"""|# Generated by canton/bootstrap.canton - do not edit by hand.
      |# For each bank and register: the party identifier and its node's address.
      |icsd.party=${icsdParty.toProtoPrimitive}
      |icsd.ledger=${ledgerEndpoint(icsd.config)}
      |centralbank.party=${centralBankParty.toProtoPrimitive}
      |centralbank.ledger=${ledgerEndpoint(centralbank.config)}
      |a.party=${alphaParty.toProtoPrimitive}
      |a.ledger=${ledgerEndpoint(alpha.config)}
      |b.party=${bravoParty.toProtoPrimitive}
      |b.ledger=${ledgerEndpoint(bravo.config)}
      |c.party=${charlieParty.toProtoPrimitive}
      |c.ledger=${ledgerEndpoint(charlie.config)}
      |""".stripMargin
)
println("[bootstrap] configuration written to ledger.properties")

// --- 7. Sanity check ----------------------------------------------------
// A ping is a real Daml transaction: participant -> sequencer -> mediator -> participant.
val latency = alpha.health.ping(bravo)

println(s"""
  |=== Topology ready (ping AlphaBank -> BravoBank: $latency) ===
  |
  |  sequencer     public :5001   admin :5002
  |  mediator                     admin :5003
  |  icsd          ledger :5011   admin :5012   json :7011
  |  centralbank   ledger :5021   admin :5022   json :7021
  |  alpha         ledger :5031   admin :5032   json :7031
  |  bravo         ledger :5041   admin :5042   json :7041
  |  charlie       ledger :5051   admin :5052   json :7051
  |
  |  ICSD         = $icsdParty
  |  CentralBank  = $centralBankParty
  |  AlphaBank    = $alphaParty
  |  BravoBank    = $bravoParty
  |  CharlieBank  = $charlieParty
  |""".stripMargin)

sys.exit(0)
