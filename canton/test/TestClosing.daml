testDefaultBeforeRepurchaseDateRefused : Script ()
testDefaultBeforeRepurchaseDateRefused = do
  m <- setupMarket
  open <- openRepo m standardTerms
  businessDate <- openDay m standardTerms.repurchaseDate
  submitMustFail m.buyer do exerciseCmd open DeclareDefault with businessDate

testDefaultAfterRepurchaseDateEndsTheAgreement : Script ()
testDefaultAfterRepurchaseDateEndsTheAgreement = do
  m <- setupMarket
  open <- openRepo m standardTerms
  businessDate <- openDay m (nextBusinessDay standardTerms.repurchaseDate)
  submit m.buyer do exerciseCmd open DeclareDefault with businessDate
  gone <- queryContractId m.seller open
  gone === None
  buyerBonds <- freeBonds m.buyer
  buyerBonds === 10000000.0
  sellerCash' <- freeCash m.seller
  sellerCash' === 11677500.0

testSellerCannotDeclareDefault : Script ()
testSellerCannotDeclareDefault = do
  m <- setupMarket
  open <- openRepo m standardTerms
  businessDate <- openDay m (nextBusinessDay standardTerms.repurchaseDate)
  submitMustFail m.seller do exerciseCmd open DeclareDefault with businessDate
