module TestProposal where

import DA.Assert ((===))
import DA.Date
import Daml.Script

import Custody
import Fixture
import Repo
import Terms

testAcceptCreatesTrade : Script ()
testAcceptCreatesTrade = do
  m <- setupMarket
  trade <- agreeTrade m standardTerms
  Some agreed <- queryContractId m.seller trade
  agreed.terms === standardTerms
  agreed.seller === m.seller
  agreed.buyer === m.buyer

testSellerCannotAcceptOwnProposal : Script ()
testSellerCannotAcceptOwnProposal = do
  m <- setupMarket
  policy <- publishPolicy m
  offer <- quote m standardTerms m.buyer
  submitMustFail m.seller do exerciseCmd offer AcceptProposal with policy, instrument = m.bond

testIneligibleInstrumentRefused : Script ()
testIneligibleInstrumentRefused = do
  m <- setupMarket
  policy <- publishPolicy m
  offer <- quote m (standardTerms with isin = "IT0005441883") m.buyer
  shown <- holdBehind m offer
  submitMustFail (actAs m.buyer <> disclose shown) do
    exerciseCmd offer AcceptProposal with policy, instrument = m.bond

testPriceNotTheDepositorysRefused : Script ()
testPriceNotTheDepositorysRefused = do
  m <- setupMarket
  policy <- publishPolicy m
  offer <- quote m (standardTerms with price = 120.0) m.buyer
  shown <- holdBehind m offer
  submitMustFail (actAs m.buyer <> disclose shown) do
    exerciseCmd offer AcceptProposal with policy, instrument = m.bond

testQuoteAtTheRepricedLevelIsTaken : Script ()
testQuoteAtTheRepricedLevelIsTaken = do
  m <- setupMarket
  policy <- publishPolicy m
  repriced <- submit m.icsd do exerciseCmd m.bond Reprice with newPrice = 97.5
  offer <- quote m (standardTerms with price = 97.5) m.buyer
  shown <- holdBehind m offer
  _ <- submit (actAs m.buyer <> disclose shown) do
    exerciseCmd offer AcceptProposal with policy, instrument = repriced
  pure ()

