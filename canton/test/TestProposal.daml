testHaircutBelowPolicyMinimumRefused = do
  m <- setupMarket
  policy <- publishPolicy m
  offer <- quote m (standardTerms with haircut = 0.01) m.buyer
  shown <- holdBehind m offer
  submitMustFail (actAs m.buyer <> disclose shown) do
