testQuantityAbovePolicyLimitRefused : Script ()
testQuantityAbovePolicyLimitRefused = do
  m <- setupMarket
  policy <- submit m.buyer do
    createCmd CollateralPolicy with
      buyer = m.buyer, sellers = [m.seller], icsd = m.icsd, centralBank = m.centralBank
      currency = "EUR"
      indicativeRate = 0.0325
      maxCashAmount = 20000000.0
      validUntil = date 2026 Dec 31
      eligible =
        [EligibleCollateral with isin = demoIsin, minHaircut = 0.02, maxQuantity = 5000000.0]
  offer <- quote m standardTerms m.buyer
  shown <- holdBehind m offer
  submitMustFail (actAs m.buyer <> disclose shown) do
    exerciseCmd offer AcceptProposal with policy, instrument = m.bond

