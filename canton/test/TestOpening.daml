testTradeCanBeCancelledBeforeSettlement : Script ()
testTradeCanBeCancelledBeforeSettlement = do
  m <- setupMarket
  trade <- agreeTrade m standardTerms
  submitMustFail m.seller do exerciseCmd trade CancelTrade
  submit (actAs [m.seller, m.buyer]) do exerciseCmd trade CancelTrade
  gone <- queryContractId m.buyer trade
  gone === None
