<?xml version="1.0" encoding="UTF-8"?>
<!--
  The global ~/.m2/settings.xml mirrors everything to a private CodeArtifact
  repository that returns 401 here. app/.mvn/maven.config points Maven at this file.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>central-direct</id>
      <name>Maven Central, no proxy</name>
      <mirrorOf>*</mirrorOf>
      <url>https://repo1.maven.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
