<configuration>
  <!-- gRPC and the Daml bindings are chatty at INFO, so the root logs WARN only. -->
  <appender name="DIAGNOSTIC" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>

  <!-- The application's own lines are read by a person watching the market: message only. -->
  <appender name="PLAIN" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>

  <logger name="pl.ayeo.repo" level="INFO" additivity="false">
    <appender-ref ref="PLAIN"/>
  </logger>

  <root level="WARN"><appender-ref ref="DIAGNOSTIC"/></root>
</configuration>
