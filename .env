# The single place for the Canton version, read by docker compose and the Makefile.
# Independent of the Daml SDK (3.4.11): the image is built from the Canton release.
CANTON_VERSION=3.5.15

# Points plain "docker compose ..." at the file in docker/, so it works from the
# repo root - as the Makefile runs it. Beware: an explicit
# "-f docker/docker-compose.yml" makes Docker read docker/.env instead of this
# one, and CANTON_VERSION comes out blank.
COMPOSE_FILE=docker/docker-compose.yml
